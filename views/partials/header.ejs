<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= settings.library_name %> ana sayfa">
      <img class="brand-mark" src="/logo.svg" alt="" width="44" height="44">
      <span class="brand-text">
        <span class="brand-title">Çiğdemim Kütüphane</span>
        <span class="brand-subtitle">Çiğdemim Derneği</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Ana menü">
      <a class="nav-link <%= currentPath.startsWith('/kitaplar') ? 'nav-link--active' : '' %>" href="/kitaplar">Kitaplar</a>
      <a class="nav-link <%= currentPath === '/hakkinda' ? 'nav-link--active' : '' %>" href="/hakkinda">Hakkında</a>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a class="nav-link <%= currentPath.startsWith('/admin') ? 'nav-link--active' : '' %>" href="/admin">Yönetim</a>
      <% } %>
      <% if (currentUser && currentUser.role === 'member') { %>
        <a class="nav-link <%= currentPath.startsWith('/hesabim') ? 'nav-link--active' : '' %>" href="/hesabim">Hesabım</a>
      <% } %>
    </nav>

    <div class="nav-actions">
      <% if (currentUser) { %>
        <% if (currentUser.role === 'member') { %>
          <span class="nav-user" title="<%= currentUser.full_name %>"><%= currentUser.full_name.split(' ')[0] %></span>
        <% } else { %>
          <span class="nav-user" title="<%= currentUser.full_name %>">Yönetici</span>
        <% } %>
        <form class="nav-form" method="post" action="/cikis">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-button" type="submit">Çıkış</button>
        </form>
      <% } else { %>
        <a class="nav-link" href="/giris">Giriş</a>
        <a class="btn btn--sm" href="/kayit">Üye ol</a>
      <% } %>
    </div>
  </div>
</header>
