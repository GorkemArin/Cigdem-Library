<%- include('../partials/head', { title: 'Hesabım' }) %>
<%- include('../partials/header') %>

<main id="main" class="page">
  <div class="container">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <div>
        <span class="eyebrow">Üye paneli</span>
        <h1>Merhaba, <%= currentUser.full_name.split(' ')[0] %></h1>
        <p>
          Üye no: <strong><%= currentUser.member_no || 'Henüz atanmadı' %></strong> ·
          <%= currentUser.email %>
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--secondary btn--sm" href="/hesabim/profil">Profil bilgilerim</a>
        <a class="btn btn--secondary btn--sm" href="/kitaplar">Kitap ara</a>
      </div>
    </div>

    <% if (currentUser.status === 'pending') { %>
      <div class="notice notice--warn">
        <strong>Üyeliğiniz onay bekliyor.</strong> Kütüphane yöneticisi başvurunuzu inceledikten sonra kitap ödünç talebi oluşturabilirsiniz.
        Profil bilgilerinizi bu sırada güncelleyebilirsiniz.
      </div>
    <% } else if (currentUser.status === 'suspended') { %>
      <div class="notice notice--danger">
        <strong>Üyeliğiniz askıda.</strong> Ödünç talebi oluşturmak için kütüphane yöneticisiyle iletişime geçin.
      </div>
    <% } %>

    <section class="dashboard-grid" aria-label="Hesap özeti">
      <div class="stat-card">
        <span class="stat-value"><%= activeCount %></span>
        <span class="stat-label">Aktif ödünç</span>
      </div>
      <div class="stat-card <%= overdueCount > 0 ? 'stat-card--danger' : 'stat-card--success' %>">
        <span class="stat-value"><%= overdueCount %></span>
        <span class="stat-label">Gecikmiş</span>
      </div>
      <div class="stat-card <%= openRequestCount > 0 ? 'stat-card--warn' : '' %>">
        <span class="stat-value"><%= openRequestCount %></span>
        <span class="stat-label">Açık talep</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= maxLoans %></span>
        <span class="stat-label">Ödünç hakkı</span>
      </div>
    </section>

    <div class="dashboard-columns">
      <section class="card">
        <div class="panel-head">
          <h2>Şu an sizde olan kitaplar</h2>
          <a href="/kitaplar">Yeni kitap bul</a>
        </div>
        <% if (activeLoans.length === 0) { %>
          <div class="panel-body">
            <p class="muted mb-0">Şu anda aktif ödüncünüz yok.</p>
          </div>
        <% } else { %>
          <div class="loan-list">
            <% for (const loan of activeLoans) { %>
              <% const due = dueInfo(loan.due_at); %>
              <div class="loan-row">
                <div>
                  <h3><a href="/kitaplar/<%= loan.book_id %>"><%= loan.book_title %></a></h3>
                  <p><%= loan.book_authors || 'Yazar belirtilmemiş' %> · Kopya <span class="code"><%= loan.inventory_no %></span></p>
                  <p>Alış: <%= formatDate(loan.loaned_at) %></p>
                </div>
                <div class="loan-row-meta">
                  <span class="badge badge--<%= due.tone === 'late' ? 'danger' : due.tone === 'soon' ? 'warn' : 'success' %>"><%= due.label %></span>
                  <p class="mt-1">Teslim: <strong><%= formatDate(loan.due_at) %></strong></p>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>

      <section class="card">
        <div class="panel-head">
          <h2>Ödünç taleplerim</h2>
          <a href="/kitaplar">Talep oluştur</a>
        </div>
        <% if (openRequests.length === 0) { %>
          <div class="panel-body">
            <p class="muted mb-0">Açık talebiniz yok.</p>
          </div>
        <% } else { %>
          <div class="loan-list">
            <% for (const request of openRequests) { %>
              <% const status = requestStatus(request.status); %>
              <div class="loan-row">
                <div>
                  <h3><a href="/kitaplar/<%= request.book_id %>"><%= request.book_title %></a></h3>
                  <p><%= formatDateTime(request.created_at) %> tarihinde oluşturuldu</p>
                  <% if (request.admin_note) { %>
                    <p>Yönetici notu: <%= request.admin_note %></p>
                  <% } %>
                </div>
                <div class="loan-row-meta">
                  <span class="badge badge--<%= status.tone %>"><%= status.label %></span>
                  <% if (request.status === 'pending') { %>
                    <form class="mt-1" method="post" action="/hesabim/talepler/<%= request.id %>/iptal" data-confirm="Talebinizi iptal etmek istediğinize emin misiniz?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--ghost btn--sm" type="submit">İptal</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>
    </div>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Geçmiş</span>
          <h2>İade ettiğim kitaplar</h2>
        </div>
      </div>

      <% if (history.length === 0) { %>
        <div class="empty-state">
          <strong>Henüz tamamlanmış bir ödüncünüz yok.</strong>
          İade ettiğiniz kitaplar burada listelenir.
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Kitap</th>
                <th>Kopya</th>
                <th>Alış</th>
                <th>Teslim</th>
                <th>İade</th>
              </tr>
            </thead>
            <tbody>
              <% for (const loan of history) { %>
                <tr>
                  <td>
                    <a class="table-title" href="/kitaplar/<%= loan.book_id %>"><%= loan.book_title %></a>
                    <p class="table-sub"><%= loan.book_authors || 'Yazar belirtilmemiş' %></p>
                  </td>
                  <td><span class="code"><%= loan.inventory_no %></span></td>
                  <td><%= formatDate(loan.loaned_at) %></td>
                  <td><%= formatDate(loan.due_at) %></td>
                  <td><%= formatDate(loan.returned_at) %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Tüm talepler</span>
          <h2>Talep geçmişim</h2>
        </div>
      </div>

      <% if (requests.length === 0) { %>
        <div class="empty-state">
          <strong>Henüz ödünç talebiniz yok.</strong>
          Katalogdan bir kitap seçerek ilk talebinizi oluşturabilirsiniz.
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tarih</th>
                <th>Kitap</th>
                <th>Durum</th>
                <th>Not</th>
              </tr>
            </thead>
            <tbody>
              <% for (const request of requests) { %>
                <% const status = requestStatus(request.status); %>
                <tr>
                  <td class="nowrap"><%= formatDateTime(request.created_at) %></td>
                  <td>
                    <a class="table-title" href="/kitaplar/<%= request.book_id %>"><%= request.book_title %></a>
                  </td>
                  <td><span class="badge badge--<%= status.tone %>"><%= status.label %></span></td>
                  <td>
                    <% if (request.admin_note) { %><span class="text-small"><%= request.admin_note %></span><% } %>
                    <% if (request.member_note) { %><p class="table-sub">Sizin notunuz: <%= request.member_note %></p><% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
