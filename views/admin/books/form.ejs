<%- include('../../partials/head', { title }) %>
<%- include('../../partials/header') %>

<main id="main" class="page page--tight">
  <div class="container">
    <%- include('../../partials/flash') %>

    <div class="page-header">
      <div>
        <span class="eyebrow">Yönetim · Kitaplar</span>
        <h1><%= mode === 'create' ? 'Yeni kitap ekle' : 'Kitap künyesini düzenle' %></h1>
        <p>
          ISBN ile Open Library’den künye çekebilir, eksik alanları elle tamamlayabilirsiniz.
          Kaydettiğinizde kitap kataloğa eklenir.
        </p>
      </div>
      <a class="btn btn--secondary btn--sm" href="<%= mode === 'edit' ? '/admin/kitaplar/' + bookId : '/admin/kitaplar' %>">← Vazgeç</a>
    </div>

    <%- include('../../partials/admin-nav', { activeAdmin }) %>

    <section class="ol-panel" data-ol-panel>
      <h2>Open Library’den künye ara</h2>
      <p class="text-small muted">
        Açık kaynak kütüphane veritabanında ISBN veya kitap adı/yazar ile arayın.
        Bir sonucu seçtiğinizde form alanları otomatik dolar; kaydetmeden önce kontrol edin.
      </p>

      <div class="ol-search-row">
        <div class="field">
          <label for="ol-isbn">ISBN (10 veya 13 haneli)</label>
          <input id="ol-isbn" type="text" inputmode="numeric" autocomplete="off" placeholder="Örn. 9789754702117" data-ol-isbn>
        </div>
        <button class="btn btn--secondary" type="button" data-ol-isbn-button>ISBN ile getir</button>
      </div>

      <div class="ol-search-row">
        <div class="field">
          <label for="ol-query">Kitap adı veya yazar</label>
          <input id="ol-query" type="search" autocomplete="off" placeholder="Örn. Tutunamayanlar Oğuz Atay" data-ol-query>
        </div>
        <button class="btn btn--secondary" type="button" data-ol-query-button>Open Library’de ara</button>
      </div>

      <p class="ol-status" data-ol-status role="status" aria-live="polite"></p>
      <div class="ol-results" data-ol-results></div>
    </section>

    <form method="post" action="<%= mode === 'create' ? '/admin/kitaplar/yeni' : '/admin/kitaplar/' + bookId + '/duzenle' %>" data-book-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="openlibrary_key" value="<%= values.openlibrary_key %>">

      <section class="form-section">
        <h2>Kitap künyesi</h2>
        <p class="hint">Yalnızca kitap adı zorunludur; diğer alanlar katalog kalitesini artırır.</p>

        <% if (errors._form) { %>
          <div class="form-error" role="alert"><%= errors._form %></div>
        <% } %>

        <div class="form-grid">
          <div class="field field--full <%= errors.title ? 'field--invalid' : '' %>">
            <label for="title">Kitap adı <span class="required">*</span></label>
            <input id="title" type="text" name="title" value="<%= values.title %>" maxlength="300" required>
            <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
          </div>

          <div class="field field--full">
            <label for="subtitle">Alt başlık</label>
            <input id="subtitle" type="text" name="subtitle" value="<%= values.subtitle %>" maxlength="300">
          </div>

          <div class="field <%= errors.authors ? 'field--invalid' : '' %>">
            <label for="authors">Yazar(lar)</label>
            <input id="authors" type="text" name="authors" value="<%= values.authors %>" maxlength="300" placeholder="Birden fazla yazarı virgülle ayırın">
            <% if (errors.authors) { %><p class="field-error"><%= errors.authors %></p><% } %>
          </div>

          <div class="field <%= errors.isbn ? 'field--invalid' : '' %>">
            <label for="isbn">ISBN</label>
            <input id="isbn" type="text" name="isbn" value="<%= values.isbn %>" maxlength="25" inputmode="numeric">
            <p class="hint">10 veya 13 haneli ISBN; tire ve boşluklar otomatik temizlenir.</p>
            <% if (errors.isbn) { %><p class="field-error"><%= errors.isbn %></p><% } %>
          </div>

          <div class="field <%= errors.publisher ? 'field--invalid' : '' %>">
            <label for="publisher">Yayınevi</label>
            <input id="publisher" type="text" name="publisher" value="<%= values.publisher %>" maxlength="200">
            <% if (errors.publisher) { %><p class="field-error"><%= errors.publisher %></p><% } %>
          </div>

          <div class="field <%= errors.published_year ? 'field--invalid' : '' %>">
            <label for="published_year">Yayın yılı</label>
            <input id="published_year" type="number" name="published_year" value="<%= values.published_year %>" min="1000" max="2100" placeholder="Örn. 1971">
            <% if (errors.published_year) { %><p class="field-error"><%= errors.published_year %></p><% } %>
          </div>

          <div class="field <%= errors.language ? 'field--invalid' : '' %>">
            <label for="language">Dil</label>
            <select id="language" name="language">
              <% for (const option of LANGUAGE_OPTIONS) { %>
                <option value="<%= option.value %>" <%= values.language === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% } %>
            </select>
            <% if (errors.language) { %><p class="field-error"><%= errors.language %></p><% } %>
          </div>

          <div class="field <%= errors.page_count ? 'field--invalid' : '' %>">
            <label for="page_count">Sayfa sayısı</label>
            <input id="page_count" type="number" name="page_count" value="<%= values.page_count %>" min="1" max="20000">
            <% if (errors.page_count) { %><p class="field-error"><%= errors.page_count %></p><% } %>
          </div>

          <div class="field field--full <%= errors.categories ? 'field--invalid' : '' %>">
            <label for="categories">Konular / kategoriler</label>
            <input id="categories" type="text" name="categories" value="<%= values.categories %>" maxlength="400" placeholder="Roman, Türk edebiyatı, Klasik…">
            <% if (errors.categories) { %><p class="field-error"><%= errors.categories %></p><% } %>
          </div>

          <div class="field field--full <%= errors.description ? 'field--invalid' : '' %>">
            <label for="description">Açıklama</label>
            <textarea id="description" name="description" maxlength="8000" placeholder="Kitabın kısa tanıtımı…"><%= values.description %></textarea>
            <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
          </div>

          <div class="field field--full <%= errors.cover_url ? 'field--invalid' : '' %>">
            <label for="cover_url">Kapak görseli adresi</label>
            <input id="cover_url" type="url" name="cover_url" value="<%= values.cover_url %>" maxlength="600" placeholder="https://covers.openlibrary.org/…">
            <% if (errors.cover_url) { %><p class="field-error"><%= errors.cover_url %></p><% } %>
            <p class="hint">Open Library sonuçlarından otomatik gelir. Boş bırakılırsa yer tutucu kapak gösterilir.</p>
          </div>
        </div>
      </section>

      <% if (mode === 'create') { %>
        <section class="form-section">
          <h2>Fiziksel kopyalar</h2>
          <p class="hint">Kitap kaydıyla birlikte otomatik envanter numarası verilen kopyalar oluşturulur. Sonradan kitap detayından kopya ekleyebilirsiniz.</p>

          <div class="form-grid">
            <div class="field <%= errors.copies_count ? 'field--invalid' : '' %>">
              <label for="copies_count">Kopya sayısı</label>
              <input id="copies_count" type="number" name="copies_count" value="<%= values.copies_count %>" min="0" max="20">
              <% if (errors.copies_count) { %><p class="field-error"><%= errors.copies_count %></p><% } %>
              <p class="hint">Şimdilik kitap eklemezseniz 0 girebilirsiniz.</p>
            </div>

            <div class="field">
              <label for="shelf_location">Raf / bölüm</label>
              <input id="shelf_location" type="text" name="shelf_location" value="<%= values.shelf_location %>" maxlength="120" placeholder="Örn. Salon A / Roman">
            </div>

            <div class="field">
              <label for="copy_condition">Kopya durumu</label>
              <select id="copy_condition" name="copy_condition">
                <% for (const option of CONDITION_OPTIONS) { %>
                  <option value="<%= option.value %>" <%= values.copy_condition === option.value ? 'selected' : '' %>><%= option.label %></option>
                <% } %>
              </select>
            </div>
          </div>
        </section>
      <% } else { %>
        <div class="notice mt-2">
          Kopya ekleme, durum değiştirme ve silme işlemleri kitap detay sayfasından yapılır.
          <a href="/admin/kitaplar/<%= bookId %>">Kitap detayına git →</a>
        </div>
      <% } %>

      <div class="form-actions">
        <button class="btn" type="submit"><%= mode === 'create' ? 'Kitabı kaydet' : 'Değişiklikleri kaydet' %></button>
        <a class="btn btn--secondary" href="<%= mode === 'edit' ? '/admin/kitaplar/' + bookId : '/admin/kitaplar' %>">Vazgeç</a>
      </div>
    </form>
  </div>
</main>

<%- include('../../partials/footer') %>
